{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Sports Hub Tauri",
  "version": "0.1.0",
  "identifier": "com.mysportshub.tauri",
  "build": {
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "My Sports Hub (Tauri)",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Live scores, schedules and stats",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
